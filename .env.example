# ---------------------------------------------------------------------------
# Copy to .env and fill in what you need.
#
# DATABASE_URL is the only required value. Everything else degrades to a
# clearly-labelled local stand-in, so the whole product is walkable without
# signing up for anything.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required.
#
# Local development — any Postgres will do:
#   docker run --name dot-db -e POSTGRES_PASSWORD=dot -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:dot@localhost:5432/postgres?schema=public"
#
# Deployed — prefer the *pooled* connection string your provider gives you.
# Serverless invocations are many and short-lived, and one direct connection per
# instance will exhaust the server's slots.
DATABASE_URL="postgresql://postgres:dot@localhost:5432/postgres?schema=public"

# Public origin of the deployment. Used to build links inside e-mails and SMS,
# and as the OAuth redirect base. Falls back to the request origin.
# APP_ORIGIN="https://tasks.example.com"

# --- Google sign-in --------------------------------------------------------
# Without these, the Google button opens a local stand-in page (development
# only — it is refused when NODE_ENV=production).
# Authorised redirect URI: <APP_ORIGIN>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- E-mail (Resend) -------------------------------------------------------
# Without a key, e-mails are logged to the server console instead of sent, and
# the UI labels them as simulated.
# RESEND_API_KEY=""
# MAIL_FROM="Distribution of Tasks <notifications@example.com>"

# --- SMS (Twilio) ----------------------------------------------------------
# Without these, SMS — including sign-up one-time codes — are logged to the
# console, and the code is shown in the form so the flow stays walkable.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15005550006"

# Set to 1 on a deployment to fill in the demo organisation — thirteen
# coworkers, their profiles and the work behind them — after the build
# migrates. It only ever adds what is missing, so it is safe to leave on and
# safe alongside accounts that signed up.
SEED_DEMO=
